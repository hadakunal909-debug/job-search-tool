# secrets — NEVER commit these
.streamlit/secrets.toml
.env
*.key

# python
__pycache__/
*.pyc

# local data (the real corpus lives in the remote database; keep local runs out of git)
jobs.csv
user_jobs.json
log.txt
users.json
user_jobs_local.json
jds.json
boards.json
jdmeta.json
# ...AND EVERY COPY OF IT. Moving jdmeta.json aside is the documented way to force a re-derive
# (_persist_derived prefers a cached entry over recomputing, so a stale file writes the old
# parser's answers straight back) -- and the renamed copy is not matched by the line above. One
# `git add -A` on 2026-09-03 committed a 71 MB jdmeta.json.pre-cleanjd for exactly that reason.
jdmeta.json.*
# THE RESUME IS THE OWNER'S, and resume.txt is tracked deliberately (the scraper scores against
# it) -- but a hand-made backup of it is not, and .gitignore had no rule that would catch one.
# The same `git add -A` also committed resume.txt.local-may30-backup.
resume.txt.*
!resume.txt
# Written by the running web app to share the feed rows across Passenger workers. Runtime
# state, regenerated on demand — must never be deployed or committed.
jobs_snapshot.json.gz
jobs_snapshot.json.gz.*.tmp
# The fingerprint sidecar next to it -- same corpus, 120 bytes of it.
jobs_snapshot.json.gz.fp.json
# Per-user match scores, same idea as the snapshot above: a rebuildable cache, not state.
score_cache/
row_cache/
# The stored job descriptions, carried between CI runs via actions/cache so the heavy scoring
# pass doesn't re-download ~128 MB from the database every day. Rebuilt from the DB on a miss.
jd_cache.json.gz
jd_cache.json.gz.tmp
brain_kb_local.json
brain_companies_local.json
resumes_local.json
scrape_status_local.json
profiles_local.json
applications_local.json

last_new_jobs.json
*.log
scrape.lock
everify_probe_report.csv
stemjobs_cpanel.zip
stemjobs_update.zip

# résumé tailoring → PDF (LaTeX via Tectonic)
bin/tectonic
bin/tectonic.exe
.tectonic-cache/
tailored_cache_local.json
learned_answers_local.json
ext_debug_log.jsonl
_m0_*.tex
_m0_*.pdf
_m0_*.log

# os / misc
.DS_Store
job-hunt-app.zip

# personal / local — not needed by the deployed app
Kunal_Job_Search_Tracker.xlsx
.claude/

# migratemate mining artifacts — REVIEW OUTPUT, regenerable, and one of them is 65 MB.
# The durable result of that work is the board list already pasted into scraper/__init__.py;
# these are the working files it came from. visa_tags.json is deliberately NOT here: the app
# reads it at runtime and there is no build step on the server, so it has to be committed.
migratemate_jobs.json
migratemate_companies.csv
migratemate_boards*.csv
migratemate_probed.txt
visa_tags_report.csv
SOURCES_lines*.txt
# The review artifact for build_companies.py's curated sector layer: which layer classified
# each company, and how much traffic it carries. Regenerate with --report; companies.json
# itself IS committed, because the app reads it and the server has no build step.
companies_report.csv

# run logs
jd_backfill_*.log

# cPanel API token — read by scripts/cpanel_setup.py, never committed.
.cpanel_token

# Generated Postgres DSN (contains the database password).
.pg_dsn

# .supabase_dsn is kept listed on purpose even though the file was deleted on 2026-09-01: an old
# script or a stale checkout must not be able to reintroduce a credential file. (.pg_dsn, which
# holds the live password, is already listed below.)
.supabase_dsn

# Shared secret for the scraper -> /api/db transport.
.db_proxy_secret
# scripts/build_logos.py --audit-domains writes this for a human to read before
# --write-domains overwrites the map. A review artefact, regenerable, never an input.
company_domains_audit.csv
# --discover-domains writes this one, same deal. Sorted by H-1B filings, with a
# distinctive_tokens column, because a one-word employer name is the case a page cannot
# disambiguate -- Alphabet corroborates perfectly against BMW's alphabet.com.
company_domains_discovered.csv

# Repo root: each project keeps its own .gitignore (see "JobMatch Scraper/.gitignore").
# These repo-wide patterns are a safety net so secrets/junk can never land from any folder.
.env
secrets.toml
*.key
__pycache__/
*.pyc
.claude/
.DS_Store

# Large reproducible data deliverables (not source) — e.g. the USCIS H-1B data hub export.
USCIS H-1B Data Hub/

# Deploy bundles built for cPanel uploads — reproducible from the tree, not source.
*_deploy.zip

# React island workspace. node_modules is never deployed; static/dist IS committed on purpose
# (cPanel runs no build step, so the bundle has to travel with the template that references it).
JobMatch Scraper/web/node_modules/
JobMatch Scraper/web/dist/
JobMatch Scraper/web/.vite/

# Local-only dev dep for scripts/test_ats_adapters.js (npm i jsdom). Never deployed.
JobMatch Scraper/node_modules/

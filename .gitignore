# Repo root: each project keeps its own .gitignore (see "JobMatch Scraper/.gitignore").
# These repo-wide patterns are a safety net so secrets/junk can never land from any folder.
.env
secrets.toml
*.key
__pycache__/
*.pyc
.claude/
.DS_Store

# Large reproducible data deliverables (not source) — e.g. the USCIS H-1B data hub export.
USCIS H-1B Data Hub/

# Deploy bundles built for cPanel uploads — reproducible from the tree, not source.
*_deploy.zip
# Dated deploy bundles (stemjobs1_<feature>_<date>.zip). Same artifact as above,
# just named per release; eight of them had accumulated untracked at the root.
stemjobs1_*.zip

# React island workspace. node_modules is never deployed; static/dist IS committed on purpose
# (cPanel runs no build step, so the bundle has to travel with the template that references it).
JobMatch Scraper/web/node_modules/
JobMatch Scraper/web/dist/
JobMatch Scraper/web/.vite/

# Local-only dev dep for scripts/test_ats_adapters.js (npm i jsdom). Never deployed.
JobMatch Scraper/node_modules/

# Review artifacts from the E-Verify+ / Adzuna probe pipeline. Each is REPRODUCIBLE from the
# tree (scraper.classify_everify -> probe_everify_candidates -> adopt_everify_boards ->
# report_companies_xlsx), and everify_categorised.csv alone is 3.1 MB of derived rows. The
# durable outputs are the code, the boards table, and everify_insights.md — not these.
JobMatch Scraper/everify_categorised.csv
JobMatch Scraper/everify_board_probe*.csv
JobMatch Scraper/everify_adoption.csv
JobMatch Scraper/jobmatch_companies.xlsx
JobMatch Scraper/adzuna_replacements.csv
JobMatch Scraper/diag_out.json

# Run logs from a local scrape/score/probe. Never source.
JobMatch Scraper/*_run.log
JobMatch Scraper/*_run2.log
JobMatch Scraper/everify_probe*.log
JobMatch Scraper/visa_tags_build.log

# Review artifacts from the LinkedIn/Indeed company-discovery pipeline, same reasoning as the
# E-Verify+ block above: every one is reproducible from the tree (scripts/discover_companies
# -> scripts/probe_discovered -> scraper.adopt_everify_boards -> scripts/report_stem_opt_xlsx)
# and the durable outputs are the code and the boards table, not these snapshots.
JobMatch Scraper/discovered_*.csv
JobMatch Scraper/recheck_*.csv
JobMatch Scraper/phase23_*.csv
JobMatch Scraper/unscrapeable_boards.csv
JobMatch Scraper/adopted_companies_*.csv

# Generated spreadsheets handed to the user, alongside jobmatch_companies.xlsx above.
JobMatch Scraper/*_report*.xlsx
JobMatch Scraper/STEM_OPT_report*.xlsx
JobMatch Scraper/adopted_companies_*.xlsx
JobMatch Scraper/unscrapeable_boards.xlsx
# Excel's lock file for an open workbook.
JobMatch Scraper/~$*.xlsx
